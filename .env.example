# ---------------------------------------------------------------------------
# AI Caller - local environment template
#
# Copy to `.env` and fill in real values locally. Never commit `.env`.
# Placeholders only in this file - no real credentials.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port for the Express server
PORT=3000

# Structured log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# PostgreSQL connection string (the ONLY supported way to configure the DB).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ai_caller?schema=public

# Optional: comma-separated list of allowed browser origins for CORS.
# Leave empty to send no cross-origin access headers (the secure default).
# Wildcard "*" is intentionally not supported.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Lead API (Phase 2) - READ ONLY
#
# The caller's key is documented as read-only. Phase 2 issues GET requests
# only: no notes, corrections, assignments or status changes.
# ---------------------------------------------------------------------------

# Funnel host serving /api/crm/*. Must be https.
LEAD_API_BASE_URL=https://guided-boost.lovable.app

# Sent as the X-Lead-API-Key header. LEAVE EMPTY HERE - set the real value only
# in your local .env, which is gitignored. The server starts without it; the
# polling command fails clearly if it is missing.
LEAD_API_KEY_CALLER=

# Per-request timeout, retry budget and page size for Lead API reads.
LEAD_API_TIMEOUT_MS=10000
LEAD_API_MAX_RETRIES=3
LEAD_API_PAGE_SIZE=200

# Optional brand filter for the incremental listing. Empty = all brands.
# LEAD_API_BRAND=

# ---------------------------------------------------------------------------
# Lead polling and eligibility (Phase 2)
# ---------------------------------------------------------------------------

# Hard bound on pages per poll run, so a run can never loop forever.
LEAD_POLL_MAX_PAGES=20

# `since` for the very first poll only, before a durable watermark exists.
# Leads already present at that moment are recorded as known-before-bootstrap
# and are never auto-called. Defaults to "now" at first run.
# LEAD_POLL_INITIAL_SINCE=2026-10-14T00:00:00.000Z

# MASTER SAFETY SWITCH - keep false until automatic calling is explicitly
# approved. While false, leads that pass every verified check are held in
# NEEDS_REVIEW instead of being marked ELIGIBLE. There is no separate
# age-based "newness window" - a lead is new if it was not present at the
# first (bootstrap) poll and has never been decided before; see
# src/services/leadEligibility.service.ts for why a fixed-age cutoff was
# tried and removed.
LEAD_ELIGIBILITY_AUTO_ENABLED=false

# Lead statuses that must never receive an initial AI call. Defaults to
# exactly the three statuses the workflow documentation names. Other statuses
# seen live (Newsletter, Unsubscribe (M), Deleted, Cancelled (NR), Dead Lead)
# are NOT blocked unless added here - that is a business decision, not ours.
LEAD_BLOCKED_STATUSES=Unsubscribe,Closed,Post Trip

# ---------------------------------------------------------------------------
# Retell outbound calling (Phase 3)
# ---------------------------------------------------------------------------

# MASTER SWITCH for placing outbound calls - INDEPENDENT of
# LEAD_ELIGIBILITY_AUTO_ENABLED. Keep false: no outbound call can be placed
# while this is false, regardless of eligibility. The Retell client calls the
# enforcement point first, before any network request. The successful manual
# dashboard test does NOT authorise automatic calling - leave this false.
RETELL_CALLING_ENABLED=false

# Verified production REST host (POST /v2/create-phone-call lives here).
RETELL_API_BASE_URL=https://api.retellai.com

# Retell API key (secret). Get it from the Retell dashboard -> API Keys.
# LEAVE EMPTY HERE - set the real value only in your local .env (gitignored).
# The server boots without it; a call fails clearly if it is missing.
RETELL_API_KEY=

# Your purchased Retell outbound number (caller ID), E.164.
RETELL_FROM_NUMBER=+19789538571

# Id of the "Travel Call Agent". Get it from the Retell dashboard -> Agents
# (open the agent; the id is in the URL / agent details).
RETELL_AGENT_ID=

# Human-readable agent name. Informational only (not sent to the API).
RETELL_AGENT_NAME=Travel Call Agent

# Per-request timeout in ms (optional; default 15000).
RETELL_TIMEOUT_MS=15000

# Webhook signature verification: there is NO separate webhook secret.
# Verified from the official Retell SDK (retell-sdk v6.2.6): Retell signs the
# `x-retell-signature` header with your RETELL_API_KEY (above), so the same key
# verifies inbound webhooks. Nothing extra to set here. If RETELL_API_KEY is
# empty, webhook verification fails closed (401/503) and no event is processed.

# ---------------------------------------------------------------------------
# PLANNED configuration - NOT read or required yet.
# Documented here so deployment owners know what is coming. Do not add real
# values until the matching phase is implemented and verified.
# ---------------------------------------------------------------------------

# Phase 4 - Calendly (consultation booking)
# CALENDLY_API_TOKEN=
# CALENDLY_EVENT_TYPE_URI=

# Phase 5 - CRM workflow (plain-text notes, booking-triggered assignment)
# Confirmed caller identity for the required X-Agent-Email header on writes.
# Not a secret - an address, not a credential - but left unset until Phase 5
# is implemented so no write code can accidentally activate early.
# CRM_AGENT_EMAIL=ai-caller@himalayanwonders.com
